{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "power-ping",
  "main": "src/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-05-06",
  "routes": [
    {
      "pattern": "power-ping.mares.ooo",
      "custom_domain": true
    },
    {
      "pattern": "www.power-ping.mares.ooo",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "DB",
      "database_id": "5613f0a0-14d7-4c0d-8cc3-3b37cb80c0a3"
    }
  ],
  "secrets": {
    "required": [
      "SECRET_KEY"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}